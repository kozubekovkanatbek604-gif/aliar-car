@page
@model Aliyar.Web.Pages.Admin.Reports.PaymentsModel
@{
    ViewData["Title"] = "Отчёт по оплатам";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Отчёт по оплатам</h1>
        <p class="page-header__subtitle">Продажи автомобилей по способу оплаты</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="Index">Все продажи</a>
        <a class="btn btn-outline-secondary" asp-page="/Index">На главную</a>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mb-4">@Model.ErrorMessage</div>
}
else
{
    <form method="get" class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">Менеджер</label>
                    <select class="form-select" name="ManagerUserId">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.ManagerUserId))">Все</option>
                        <option value="__none__" selected="@(Model.ManagerUserId == "__none__")">Без менеджера</option>
                        @foreach (var m in Model.Managers)
                        {
                            <option value="@m.UserId" selected="@(Model.ManagerUserId == m.UserId)">@m.Label</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">С даты</label>
                    <input type="date" class="form-control" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">По дату</label>
                    <input type="date" class="form-control" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Фильтр</button>
                    <a class="btn btn-outline-secondary w-100" asp-page="Payments">Сброс</a>
                </div>
            </div>
        </div>
    </form>

    @if (Model.Summary.Count == 0)
    {
        <div class="empty-state">Продаж пока нет.</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var s in Model.Summary)
            {
                <div class="col-12 col-md-4">
                    <div class="stat-card">
                        <div class="stat-card__label">@s.PaymentMethod.ToDisplayNameRu()</div>
                        <div class="stat-card__value">@MoneyFormat.Usd(s.TotalRevenue)</div>
                        <div class="text-muted">Продаж: @s.TotalSales</div>
                    </div>
                </div>
            }
        </div>

        @foreach (var group in Model.Groups)
        {
            <div class="detail-card mb-4">
                <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-2">
                    <div>
                        <h2 class="mb-0">@group.PaymentMethod.ToDisplayNameRu()</h2>
                        <div class="text-muted">
                            Продаж: @group.TotalSales, выручка: @MoneyFormat.Usd(group.TotalRevenue)
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Автомобиль</th>
                                <th>Клиент</th>
                                <th class="text-end">Сумма</th>
                                <th>Менеджер</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in group.Rows)
                        {
                            <tr>
                                <td class="text-nowrap">@row.SoldAtUtc.ToLocalTime().ToString("g")</td>
                                <td>@row.CarTitle</td>
                                <td>@row.CustomerName</td>
                                <td class="text-end">@MoneyFormat.Usd(row.SalePrice)</td>
                                <td class="text-muted">@row.SoldBy</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

