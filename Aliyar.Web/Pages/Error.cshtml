@page
@model ErrorModel
@{
    ViewData["Title"] = "Ошибка";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Что-то пошло не так</h1>
        <p class="page-header__subtitle">При обработке запроса произошла ошибка</p>
    </div>
</header>

@if (Model.ShowRequestId)
{
    <div class="surface-panel mb-4">
        <p class="mb-0 small text-muted">Идентификатор запроса: <code>@Model.RequestId</code></p>
    </div>
}

<div class="surface-panel">
    <p class="mb-3">Попробуйте вернуться на главную или повторить действие позже.</p>
    <a class="btn btn-primary" asp-page="/Index">На главную</a>
</div>
