<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aliyar Auto</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aliyar.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="app-header">
            <nav class="navbar navbar-expand-md app-navbar">
                <div class="container">
                    <a class="navbar-brand app-brand" asp-area="" asp-page="/Index">
                        <span class="app-brand__name">Aliyar</span>
                        <span class="app-brand__tag">Auto</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNav"
                            aria-controls="appNav" aria-expanded="false" aria-label="Меню">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="appNav">
                        <ul class="navbar-nav app-nav me-auto mb-2 mb-md-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Index">Главная</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Cars/Index">Автосалон</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Listings/Index">Объявления</a>
                            </li>
                            @if (User.CanPostListings())
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/MyListings/Index">Мои объявления</a>
                                </li>
                            }
                            @if (User.IsAppAdmin())
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Managers/Index">Менеджеры</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Reservations/Index">Брони</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Clients/Index">Клиенты</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Reports/Index">Отчёты</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/ArchivedCars/Index">Архив</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/About">О проекте</a>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <main class="container app-main" role="main">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.UtcNow.Year Aliyar Auto</span>
                <a asp-area="" asp-page="/Privacy">Политика конфиденциальности</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
