@using Aliyar.Web.Data
@using Aliyar.Web.Security
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject AppDbContext Db

<ul class="navbar-nav app-user ms-md-auto align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var displayName = User.Identity?.Name;
    if (User.IsClient())
    {
        var fullName = await ClientDisplayName.GetFullNameAsync(Db, User.GetUserId());
        if (!string.IsNullOrWhiteSpace(fullName))
            displayName = fullName;
    }
    <li class="nav-item">
        <span class="nav-link">@displayName</span>
    </li>
    <li class="nav-item">
        <form class="app-logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
            <button type="submit" class="nav-link btn btn-link">Выйти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Вход</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm app-user-register" asp-area="Identity" asp-page="/Account/RegisterClient">Регистрация</a>
    </li>
}
</ul>
