@page "{id:int}"
@model Aliyar.Web.Pages.Cars.DeleteModel
@{
    ViewData["Title"] = "Удалить авто";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Удалить авто</h1>
        <p class="page-header__subtitle">@Model.Car.Make @Model.Car.Model</p>
    </div>
</header>

<div class="alert alert-danger mb-4">
    Это действие нельзя отменить. Удалить <strong>@Model.Car.Make @Model.Car.Model</strong>?
</div>

<div class="surface-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Год</dt>
        <dd class="col-sm-9">@Model.Car.Year</dd>
        <dt class="col-sm-3">Цена</dt>
        <dd class="col-sm-9">@MoneyFormat.Usd(Model.Car.Price)</dd>
        <dt class="col-sm-3">VIN</dt>
        <dd class="col-sm-9 text-muted">@(Model.Car.Vin ?? "—")</dd>
    </dl>
</div>

<form method="post" class="d-flex gap-2">
    <button class="btn btn-danger" type="submit">Удалить</button>
    <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@Model.Car.Id">Отмена</a>
</form>
