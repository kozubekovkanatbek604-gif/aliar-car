@page
@model Aliyar.Web.Pages.Cars.IndexModel
@using Aliyar.Web.Pages.Shared
@{
    ViewData["Title"] = "Автосалон";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Автосалон</h1>
        <p class="page-header__subtitle">Автомобили в наличии — выберите и откройте карточку для подробностей</p>
    </div>
    @if (User.CanManageCars())
    {
        <a class="btn btn-primary" asp-page="Create">Добавить авто</a>
    }
</header>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success mb-4">@statusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mb-4">@Model.ErrorMessage</div>
}

@{
    ViewData["FilterResetPage"] = "/Cars/Index";
}
<partial name="_CarCatalogFilter" model="Model.Filter" />

@if (Model.Cars.Count == 0)
{
    <div class="empty-state">В автосалоне пока нет автомобилей.</div>
}
else
{
    <div class="vehicle-grid">
        @foreach (var car in Model.Cars)
        {
            Model.CoverPhotoUrls.TryGetValue(car.Id, out var photoUrl);
            <partial name="_CarCard" model="new CarCardViewModel
            {
                Car = car,
                CoverPhotoUrl = photoUrl,
                ShowStatus = true,
                ShowManageActions = User.CanManageCars(),
            }" />
        }
    </div>
}
