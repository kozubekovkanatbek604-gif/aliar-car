@page "{id:int}"
@model Aliyar.Web.Pages.Cars.EditNameModel
@{
    ViewData["Title"] = "Изменить название";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Изменить название</h1>
        <p class="page-header__subtitle">Марка и модель</p>
    </div>
</header>

<form method="post" class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Марка</label>
                <input class="form-control" asp-for="Car.Make" />
                <span class="text-danger" asp-validation-for="Car.Make"></span>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Модель</label>
                <input class="form-control" asp-for="Car.Model" />
                <span class="text-danger" asp-validation-for="Car.Model"></span>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Сохранить</button>
        <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@Model.Id">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
