@page "{id:int}"
@model Aliyar.Web.Pages.Cars.DetailsModel
@using Aliyar.Web.Models
@{
    ViewData["Title"] = $"{Model.Car.Make} {Model.Car.Model}";
    var isCustomerListing = Model.Car.IsCustomerListing();
    var backPage = isCustomerListing ? "/Listings/Index" : "/Cars/Index";
    var backLabel = isCustomerListing ? "К объявлениям" : "К автосалону";
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success mb-4">@statusMessage</div>
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">@Model.Car.Make @Model.Car.Model</h1>
        @if (isCustomerListing)
        {
            <p class="page-header__subtitle">Объявление клиента</p>
        }
        else
        {
            <p class="page-header__subtitle">
                @if (Model.Car.IsArchived)
                {
                    <span class="badge text-bg-secondary">В архиве</span>
                }
                else if (Model.Car.IsOutOfStock())
                {
                    <span class="badge text-bg-warning">В наличии нет</span>
                }
                else
                {
                    <span class="badge text-bg-success">В продаже</span>
                }
            </p>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (User.CanManageCustomerListing(Model.Car) && !Model.Car.IsSold && !Model.Car.IsArchived)
        {
            <a class="btn btn-outline-primary btn-sm" asp-page="/MyListings/Edit" asp-route-id="@Model.Car.Id">Редактировать</a>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Cars/Specifications/Edit" asp-route-carId="@Model.Car.Id">Технические характеристики</a>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/MyListings/Photos" asp-route-id="@Model.Car.Id">
                @(Model.PhotoUrls.Count == 0 ? "Добавить фото" : $"Фото ({Model.PhotoUrls.Count})")
            </a>
            <a class="btn btn-outline-danger btn-sm" asp-page="/MyListings/Delete" asp-route-id="@Model.Car.Id">Удалить</a>
        }
        @if (User.CanManageCars() && Model.Car.IsStoreListing() && !Model.Car.IsArchived)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-page="UploadPhoto" asp-route-id="@Model.Car.Id">
                @(Model.PhotoUrls.Count == 0 ? "Добавить фото" : $"Фото ({Model.PhotoUrls.Count})")
            </a>
            @if (Model.Car.IsCatalogAvailable())
            {
                <a class="btn btn-success btn-sm" asp-page="Sell" asp-route-id="@Model.Car.Id">Продать</a>
            }
            <a class="btn btn-outline-secondary btn-sm" asp-page="EditName" asp-route-id="@Model.Car.Id">Название</a>
            <a class="btn btn-outline-primary btn-sm" asp-page="Edit" asp-route-id="@Model.Car.Id">Редактировать</a>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Cars/Specifications/Edit" asp-route-carId="@Model.Car.Id">Технические характеристики</a>
        }
        @if (User.IsAppAdmin() && Model.Car.IsStoreListing())
        {
            @if (!Model.Car.IsArchived)
            {
                @if (Model.Car.IsStoreListing())
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="EditStock" asp-route-id="@Model.Car.Id">На складе</a>
                }
                <form class="d-inline" method="post" asp-page-handler="Archive" asp-route-id="@Model.Car.Id"
                      onsubmit="return confirm('Заархивировать автомобиль? Он исчезнет из каталога.');">
                    <button type="submit" class="btn btn-outline-warning btn-sm">В архив</button>
                </form>
                <a class="btn btn-outline-danger btn-sm" asp-page="Delete" asp-route-id="@Model.Car.Id">Удалить</a>
            }
            else
            {
                <form class="d-inline" method="post" asp-page-handler="Restore" asp-route-id="@Model.Car.Id">
                    <button type="submit" class="btn btn-outline-success btn-sm">Восстановить</button>
                </form>
            }
        }
        @if (User.IsAppAdmin() && !Model.Car.IsStoreListing() && !Model.Car.IsArchived)
        {
            <a class="btn btn-outline-danger btn-sm" asp-page="Delete" asp-route-id="@Model.Car.Id">Удалить</a>
        }
    </div>
</header>

@if (isCustomerListing)
{
    <p class="mb-4">
        @if (Model.Car.IsSold)
        {
            <span class="badge text-bg-secondary">Продан</span>
        }
        else if (Model.Car.IsArchived)
        {
            <span class="badge text-bg-secondary">В архиве</span>
        }
        else
        {
            <span class="badge text-bg-success">В продаже</span>
        }
    </p>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        @if (Model.PhotoUrls.Count > 0)
        {
            ViewData["CarPhotoAlt"] = $"Фото {Model.Car.Make} {Model.Car.Model}";
            <partial name="_CarPhotoCarousel" model="Model.PhotoUrls" />
        }
        else
        {
            <div class="vehicle-card__placeholder vehicle-detail__no-photo" aria-hidden="true">
                <span class="vehicle-card__placeholder-icon">🚗</span>
            </div>
        }
    </div>
    <div class="col-lg-5">
        <p class="vehicle-detail__price">@MoneyFormat.Usd(Model.Car.Price) <span>цена продажи</span></p>
        @if (User.CanManageCars() && Model.Car.IsStoreListing())
        {
            <div class="surface-panel mb-3">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Цена закупки</dt>
                    <dd class="col-sm-6">@MoneyFormat.Usd(Model.Car.PurchasePrice)</dd>
                    @if (!Model.Car.IsSold)
                    {
                        <dt class="col-sm-6">Маржа за ед.</dt>
                        <dd class="col-sm-6 text-success">@MoneyFormat.Usd(CarProfit.UnitMargin(Model.Car))</dd>
                    }
                </dl>
            </div>
        }
        @if (Model.Car.IsStoreListing())
        {
            <p class="text-muted mb-3">@(Model.Car.IsOutOfStock() ? "В наличии нет" : $"На складе: {Model.Car.StockQuantity}")</p>
        }
        @if (Model.Specification is not null)
        {
            <p class="mb-3">
                <a class="btn btn-outline-primary btn-sm" asp-page="/Cars/Specifications/Index" asp-route-carId="@Model.Car.Id">
                    Технические характеристики
                </a>
            </p>
        }
        else if (User.CanEditCarSpecifications(Model.Car))
        {
            <div class="alert alert-warning py-2 px-3 mb-3">
                Заполните <a asp-page="/Cars/Specifications/Edit" asp-route-carId="@Model.Car.Id">технические характеристики</a>.
            </div>
        }
        <div class="surface-panel">
            <dl class="row mb-0">
                <dt class="col-sm-4">Марка</dt>
                <dd class="col-sm-8">@Model.Car.Make</dd>
                <dt class="col-sm-4">Модель</dt>
                <dd class="col-sm-8">@Model.Car.Model</dd>
                <dt class="col-sm-4">Год</dt>
                <dd class="col-sm-8">@Model.Car.Year</dd>
                <dt class="col-sm-4">VIN</dt>
                <dd class="col-sm-8 text-muted">@(Model.Car.Vin ?? "—")</dd>
            </dl>
        </div>
    </div>
</div>

@if (User.CanUseCart() && Model.Car.IsStoreListing() && Model.Car.IsCatalogAvailable())
{
    <form method="post" asp-page="/Cart/Index" asp-page-handler="Add" class="mb-4 d-flex gap-2 align-items-end flex-wrap">
        <input type="hidden" name="carId" value="@Model.Car.Id" />
        <div>
            <label class="form-label">Количество</label>
            <input type="number" name="quantity" class="form-control" min="1" max="@Model.Car.StockQuantity" value="1" style="width: 140px;" />
        </div>
        <button type="submit" class="btn btn-success">В корзину</button>
        <a class="btn btn-outline-secondary" asp-page="/Cart/Index">Открыть корзину</a>
    </form>
}

@if (Model.Car.IsCatalogAvailable())
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3" style="letter-spacing: 0.04em; font-size: 0.75rem;">Бронь</h2>

            @if (Model.ActiveReservation is not null)
            {
                <div class="alert alert-warning mb-0">
                    Уже забронирован до @Model.ActiveReservation.ReservedUntilUtc.ToLocalTime().ToString("g")
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Reserve" class="d-flex flex-column gap-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-0"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.CustomerName" class="form-label"></label>
                            <input asp-for="Input.CustomerName" class="form-control" />
                            <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.CustomerPhone" class="form-label"></label>
                            <input asp-for="Input.CustomerPhone" class="form-control" />
                            <span asp-validation-for="Input.CustomerPhone" class="text-danger"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Input.CustomerDetails" class="form-label"></label>
                        <input asp-for="Input.CustomerDetails" class="form-control" placeholder="Например: паспорт/ИИН (если нужно)" />
                        <span asp-validation-for="Input.CustomerDetails" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="Input.DurationHours" class="form-label"></label>
                            <select asp-for="Input.DurationHours" class="form-select">
                                <option value="1">1 час</option>
                                <option value="3">3 часа</option>
                                <option value="24">1 сутки</option>
                                <option value="48">2 суток</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Input.Quantity" class="form-label"></label>
                            @if (Model.Car.IsStoreListing())
                            {
                                <input asp-for="Input.Quantity" type="number" class="form-control" min="1" max="@Model.Car.StockQuantity" />
                            }
                            else
                            {
                                <input asp-for="Input.Quantity" type="number" class="form-control" min="1" max="1" value="1" readonly />
                            }
                            <span asp-validation-for="Input.Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary align-self-start">Забронировать</button>
                </form>
            }
        </div>
    </div>
}

@if (Model.Sale is not null)
{
    <div class="detail-card">
        <h2>Данные продажи</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3">Клиент</dt>
            <dd class="col-sm-9">@Model.Sale.CustomerName</dd>
            <dt class="col-sm-3">Оплата</dt>
            <dd class="col-sm-9">@Model.Sale.PaymentMethod.ToDisplayNameRu()</dd>
            <dt class="col-sm-3">Кол-во</dt>
            <dd class="col-sm-9">@Model.Sale.Quantity</dd>
            <dt class="col-sm-3">Сумма</dt>
            <dd class="col-sm-9">@MoneyFormat.Usd(Model.Sale.SalePrice)</dd>
            @if (User.CanManageCars() && Model.Car.IsStoreListing())
            {
                <dt class="col-sm-3">Чистая прибыль</dt>
                <dd class="col-sm-9 text-success fw-semibold">@MoneyFormat.Usd(CarProfit.NetProfit(Model.Car, Model.Sale))</dd>
            }
            <dt class="col-sm-3">Дата</dt>
            <dd class="col-sm-9">@Model.Sale.SoldAtUtc.ToLocalTime().ToString("g")</dd>
        </dl>
    </div>
}

<a class="btn btn-outline-secondary" asp-page="@backPage">@backLabel</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}