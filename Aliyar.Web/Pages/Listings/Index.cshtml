@page
@model Aliyar.Web.Pages.Listings.IndexModel
@using Aliyar.Web.Pages.Shared
@{
    ViewData["Title"] = "Объявления";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Объявления</h1>
        <p class="page-header__subtitle">Автомобили от частных продавцов на нашей площадке</p>
    </div>
    @if (User.CanPostListings())
    {
        <a class="btn btn-primary" asp-page="/MyListings/Create">Разместить объявление</a>
    }
    else if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/RegisterClient">Регистрация и продажа</a>
        <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/MyListings/Create")">Войти</a>
    }
</header>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mb-4">@Model.ErrorMessage</div>
}

@{
    ViewData["FilterResetPage"] = "/Listings/Index";
}
<partial name="_CarCatalogFilter" model="Model.Filter" />

@if (Model.Listings.Count == 0)
{
    <div class="empty-state">Пока нет активных объявлений. Станьте первым продавцом.</div>
}
else
{
    <div class="vehicle-grid">
        @foreach (var car in Model.Listings)
        {
            Model.CoverPhotoUrls.TryGetValue(car.Id, out var photoUrl);
            <partial name="_CarCard" model="new CarCardViewModel
            {
                Car = car,
                CoverPhotoUrl = photoUrl,
                ShowStatus = false,
                ShowManageActions = false,
            }" />
        }
    </div>
}
