@page "{id:int}"
@model Aliyar.Web.Pages.MyListings.EditModel
@{
    ViewData["Title"] = "Редактировать объявление";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Редактировать объявление</h1>
    </div>
</header>

<form method="post" class="card">
    <div class="card-body">
        <partial name="/Pages/Cars/_CarForm.cshtml" model="Model" />
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Сохранить</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
