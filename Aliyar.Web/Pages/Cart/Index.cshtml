@page
@model Aliyar.Web.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Корзина";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Корзина</h1>
        <p class="page-header__subtitle">Оформление продажи со склада</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Cars/Index">В автосалон</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success mb-4">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mb-4">@Model.ErrorMessage</div>
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state">Корзина пуста.</div>
}
else
{
    <div class="detail-card mb-4">
        <h2>Товары</h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Автомобиль</th>
                        <th class="text-end">Цена</th>
                        <th class="text-center">Кол-во</th>
                        <th class="text-end">Сумма</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.CarTitle <span class="text-muted">(на складе: @item.StockQuantity)</span></td>
                        <td class="text-end">@MoneyFormat.Usd(item.UnitPrice)</td>
                        <td class="text-center">
                            <form method="post" asp-page-handler="Update" class="d-inline-flex gap-2 align-items-center">
                                <input type="hidden" name="carId" value="@item.CarId" />
                                <input type="number" name="quantity" class="form-control form-control-sm"
                                       min="0" max="@item.StockQuantity" value="@item.Quantity" style="width: 90px;" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Ок</button>
                            </form>
                        </td>
                        <td class="text-end">@MoneyFormat.Usd(item.LineTotal)</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Remove" class="d-inline">
                                <input type="hidden" name="carId" value="@item.CarId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Итого</th>
                        <th class="text-end">@MoneyFormat.Usd(Model.Total)</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="card col-12 col-lg-6">
        <div class="card-body">
            <h2 class="h5 mb-3">Оформление</h2>
            <form method="post" asp-page-handler="Checkout">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Checkout.CustomerName" class="form-label"></label>
                    <input asp-for="Checkout.CustomerName" class="form-control" />
                    <span asp-validation-for="Checkout.CustomerName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Checkout.PaymentMethod" class="form-label"></label>
                    <select asp-for="Checkout.PaymentMethod" class="form-select">
                        <option value="0">Наличка</option>
                        <option value="1">Карта</option>
                        <option value="2">QR</option>
                    </select>
                    <span asp-validation-for="Checkout.PaymentMethod" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-success">Оформить продажу</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

