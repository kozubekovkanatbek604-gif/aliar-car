@page
@model Aliyar.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<header class="page-header">
    <div>
        <h1 class="page-header__title">Вход</h1>
        <p class="page-header__subtitle">Введите логин и пароль</p>
    </div>
</header>

<form id="loginForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="card auth-form">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Input.Login" class="form-label"></label>
            <input asp-for="Input.Login" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Login" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-0">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label"></label>
        </div>
    </div>
    <div class="card-footer d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Войти</button>
        <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/RegisterClient">Регистрация клиента</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
